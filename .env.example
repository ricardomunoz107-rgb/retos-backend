SECRET_KEY=replace-this-with-a-private-development-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# SQLite es la opción local predeterminada.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# Para PostgreSQL, reemplaza los valores y configura DB_ENGINE:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=retos_db
# DB_USER=admin_retos
# DB_PASSWORD=change-this-password
# DB_HOST=localhost
# DB_PORT=5432
