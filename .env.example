SECRET_KEY=replace-this-with-a-private-development-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL es el motor recomendado para este proyecto.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=retos_db
DB_USER=admin_retos
DB_PASSWORD=change-this-password
DB_HOST=localhost
DB_PORT=5432

# En producción, Render configura DATABASE_URL desde su PostgreSQL administrado.
# No compartas ni publiques la URL real de la base de datos.

# Para volver a usar SQLite, reemplaza las variables anteriores por:
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3
